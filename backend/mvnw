# Apache Maven Wrapper startup shell script, version 3.3.2

set -e

MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"

DISTRIBUTION_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2)
WRAPPER_URL=$(grep 'wrapperUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2)

DISTRIBUTION_FILENAME="${DISTRIBUTION_URL##*/}"
DISTRIBUTION_ID="${DISTRIBUTION_FILENAME%-bin.zip}"
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${DISTRIBUTION_ID}/${DISTRIBUTION_ID}"

if [ -f "${MAVEN_HOME}/bin/mvn" ]; then
  exec "${MAVEN_HOME}/bin/mvn" "$@"
fi

if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
  echo "Downloading maven-wrapper.jar from $WRAPPER_URL"
  curl -sL "$WRAPPER_URL" -o "$MAVEN_WRAPPER_JAR" || \
    wget -q "$WRAPPER_URL" -O "$MAVEN_WRAPPER_JAR"
fi

exec java -jar "$MAVEN_WRAPPER_JAR" "$@"
